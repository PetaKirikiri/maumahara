# maumahara — same Supabase project as akomanga / Pūrākau (shared data)
# Project ref: vuxeemwxdldfjybzgtxc → https://vuxeemwxdldfjybzgtxc.supabase.co
# Copy to `.env` and copy keys from Pūrākau’s `.env` where names match.

# When opening via Akomanga dev (localhost:5174/maumahara/... proxy): npm run dev:shell or VITE_APP_BASE=/maumahara/
# Vercel (Maumahara project): set VITE_APP_BASE=/maumahara/ on Production and Preview builds.

# Products menu: when this deployment has its own *.vercel.app host, set shell origin so links hit Akomanga.
# VITE_ECOSYSTEM_SHELL_ORIGIN=https://akomanga.vercel.app

# Optional — “Open Pūrākau” (defaults to https://purakau.nz)
# VITE_PURAKAU_APP_URL=https://your-deployment.vercel.app

# Supabase (browser) — Dashboard → Settings → API → URL + anon public
VITE_SUPABASE_URL=https://vuxeemwxdldfjybzgtxc.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Drizzle Kit — direct Postgres (also used by `npm run gpt:short-glosses` backfill)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.vuxeemwxdldfjybzgtxc.supabase.co:5432/postgres

# —— GPT (same as Pūrākau: edge functions + local scripts) ——
# Pūrākau .env: copy OPENAI_API_KEY and optionally OPENAI_SUGGEST_MODEL here.
# Supabase Edge (shared project): key may already be set:
#   supabase secrets set OPENAI_API_KEY=sk-... --project-ref vuxeemwxdldfjybzgtxc
# Optional model override (default in code: gpt-4o-mini):
# OPENAI_SUGGEST_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_SUGGEST_MODEL=

# Pūrākau also has: npm run secrets:openai:from-smartersubs  (pushes key to Supabase Edge)
