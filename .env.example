# maumahara — same Supabase project as akomanga / Pūrākau (shared data)
# Project ref: vuxeemwxdldfjybzgtxc → https://vuxeemwxdldfjybzgtxc.supabase.co
# Copy to `.env` or mirror keys from akomanga’s `.env` / Pūrākau.

# Optional — “Open Pūrākau” (defaults to https://purakau.nz)
# VITE_PURAKAU_APP_URL=https://your-deployment.vercel.app

# Supabase (browser) — Dashboard → Settings → API → URL + anon public
VITE_SUPABASE_URL=https://vuxeemwxdldfjybzgtxc.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Drizzle Kit — direct Postgres (not exposed to the browser)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.vuxeemwxdldfjybzgtxc.supabase.co:5432/postgres

# OpenAI API Key (optional — only if you add GPT features here)
VITE_OPENAI_API_KEY=sk-...

VITE_AI4THAI_API_KEY=
VITE_GOOGLE_TTS_API_KEY=
